#
# Zero-SPA Access Control Configuration
# /etc/fwknop/access.conf
#
# This file defines who can access what services via SPA
#
# IMPORTANT: Replace the KEY_BASE64 and HMAC_KEY_BASE64 values with
# keys generated by: ../shared/keygen.sh
#

##############################################################################
# Default User Access Stanza
# Allows access to protected ports after valid SPA packet
##############################################################################

# User: eddy
# Access: SSH (22), HTTP (8080), HTTPS (443)
SOURCE                      ANY

# Ports that can be opened via SPA
# Format: proto/port or proto/port,proto/port,...
OPEN_PORTS                  tcp/8080

# Require the client to specify their source IP in the SPA packet
REQUIRE_SOURCE_ADDRESS      Y

# Encryption key (Rijndael/AES) - Base64 encoded
# Generate with: fwknop --key-gen
KEY_BASE64                  __REPLACE_WITH_GENERATED_KEY__

# HMAC authentication key - Base64 encoded
# Generate with: fwknop --key-gen
HMAC_KEY_BASE64             __REPLACE_WITH_GENERATED_HMAC_KEY__

# Firewall access timeout in seconds
# Port will be closed after this duration
FW_ACCESS_TIMEOUT           30

