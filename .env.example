# STA/SAS PCE API Configuration
# Copy this file to .env and fill in your values

# REST API Endpoint (for token provisioning)
REST_API_Endpoint_Url=https://api.eu.safenetid.com/api/v1/tenants/YOUR_TENANT_ID/

# SCIM API Endpoint (for user management)
SCIM_API_Endpoint_Url=https://api.eu.safenetid.com/tenants/YOUR_TENANT_ID/scim/v2/

# API Key from STA Console
API_KEY=your_api_key_here
